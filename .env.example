# ============================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================================
DB_HOST=localhost
DB_NAME=educacion_financiera
DB_USER=root
DB_PASSWORD=

# ============================================================
# CONFIGURACIÓN DE SEGURIDAD
# ============================================================
# Tiempo de vida de la sesión en segundos (86400 = 24 horas)
SESSION_LIFETIME=86400

# ============================================================
# CONFIGURACIÓN DE EMAIL (opcional)
# ============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASSWORD=tu-contraseña
# SMTP_ENCRYPTION=tls
# EMAIL_FROM=noreply@tudominio.com
# EMAIL_FROM_NAME=Educación Financiera

# ============================================================
# CONFIGURACIÓN DE ENTORNO
# ============================================================
# development, staging, production
APP_ENV=development

# Habilitar debug (true en desarrollo, false en producción)
APP_DEBUG=true

# ============================================================
# CONFIGURACIÓN DE RATE LIMITING
# ============================================================
# Máximo de intentos de login permitidos
RATE_LIMIT_LOGIN_MAX=5

# Ventana de tiempo en minutos para rate limiting
RATE_LIMIT_WINDOW=15

# ============================================================
# CONFIGURACIÓN DE CORS
# ============================================================
# Orígenes permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
